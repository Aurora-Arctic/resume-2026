{
  "name": "resume-2026",
  "private": true,
  "description": "My resume for 2026 made in Gatsby.",
  "scripts": {
    "develop": "gatsby develop --host 0.0.0.0 --port 8000",
    "build": "gatsby build",
    "serve": "gatsby serve --host 0.0.0.0 --port \"${PORT:-8000}\"",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pre-commit": "npm run lint && npm run format:check && npm run typecheck"
  },
  "pre-commit": [
    "lint",
    "format:check",
    "typecheck"
  ],
  "dependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "gatsby": "^5.16.1",
    "gatsby-plugin-sass": "^6.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "pre-commit@1.2.2": true
  }
}
