{
  "name": "resume-2026",
  "private": true,
  "description": "My resume for 2026 made in Gatsby.",
  "scripts": {
    "predevelop": "node Docker/link-public.js ensure",
    "develop": "gatsby develop --host 0.0.0.0 --port 8000",
    "prebuild": "node Docker/link-public.js ensure",
    "build": "gatsby build",
    "preanalyze": "node Docker/link-public.js ensure",
    "analyze": "ANALYZE_BUNDLE=true gatsby build",
    "serve": "gatsby serve --host 0.0.0.0 --port \"${PORT:-8000}\"",
    "clean": "node Docker/clean.js",
    "postclean": "node Docker/link-public.js reset",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "npm run clean && E2E_COVERAGE=true playwright test",
    "pre-commit": "npm run lint && npm run format:check && npm run typecheck",
    "generate:key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-key.ts",
    "encrypt:value": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/encrypt-value.ts"
  },
  "pre-commit": [
    "lint",
    "format:check",
    "typecheck"
  ],
  "dependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "gatsby": "^5.16.1",
    "gatsby-plugin-sass": "^6.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "monocart-coverage-reports": "^2.12.12",
    "oxlint": "^1.78.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10",
    "webpack-bundle-analyzer": "^5.3.1"
  },
  "allowScripts": {
    "pre-commit@1.2.2": true
  }
}
