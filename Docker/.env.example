# Copy this file to Docker/.env (git-ignored) and fill in the value.
#
# Long-lived token so the devcontainer's Claude Code CLI is already logged in
# on start, instead of needing `/login` every rebuild. Generate on your host
# with `claude setup-token` (macOS stores normal login creds in Keychain,
# which can't be bind-mounted into a Linux container).
CLAUDE_CODE_OAUTH_TOKEN=sk-XXX-XXX-XXXXXXXXXXXXX
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXX
RESUME_CONTACT_KEY=XXXXXXXXXXXX # This key is used to encrypt/decrypt the contact information in the resume. It should be a random string of at least 32 characters.