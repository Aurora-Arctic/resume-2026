FROM node:24.18.1 AS builder

WORKDIR /app

RUN chown node:node /app

COPY --chown=node:node ./package.json ./package-lock.json /app/

USER node

RUN npm i

FROM builder AS testing

USER root

# Shared libs headless Playwright browsers need to launch (Chromium etc.) —
# see `npx playwright install-deps`. Kept as its own stage so it can be used
# standalone (e.g. CI running `npm run test:e2e`) without the devcontainer's
# interactive tooling below.
RUN apt-get update && apt-get install -y \
    libnspr4 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libdbus-1-3 \
    libcups2 \
    libxkbcommon0 \
    libasound2 \
    libgbm1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libatspi2.0-0 \
    && apt-get clean

# Fixed, $HOME-independent browser cache location. Playwright defaults to
# $HOME/.cache/ms-playwright, but GitHub Actions container jobs force
# HOME=/github/home on every step — at container-create time, unconditionally,
# overriding any -e HOME set via container.options — which broke that default
# in real CI even though it worked locally and under `act` (see playwright.yml
# and CI-SETUP.md). Baking PLAYWRIGHT_BROWSERS_PATH into the image makes the
# browser location independent of whatever $HOME resolves to in any execution
# context. Must match at install time and run time (Playwright's own
# requirement) — ENV here satisfies that for both the RUN below and every
# later container invocation.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN mkdir -p /ms-playwright && chown node:node /ms-playwright

USER node

# Browser binary matching the sole project configured in playwright.config.ts.
# Baked in here (rather than left to a one-time `npx playwright install`) so the
# testing image can run `npm run test:e2e` standalone with no setup step.
RUN npx playwright install chromium

FROM testing AS devcontainer

USER root

RUN apt-get update && apt-get install -y \
    nano \
    bubblewrap \
    socat \
    zsh \
    curl \
    git \
    && apt-get clean

USER node

RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended \
    && sed -i 's/^plugins=(.*/plugins=(git z)/' /home/node/.zshrc
