{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gatsby: develop (Node, auto-attach Chrome)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--nolazy"],
      "program": "${workspaceFolder}/node_modules/gatsby/cli.js",
      "args": ["develop", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "You can now view",
        "uriFormat": "http://localhost:8000",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Chrome: attach to running dev server",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "webpack://resume-2026/./*": "${workspaceFolder}/src/*",
        "webpack://resume-2026/*": "*"
      }
    }
  ]
}
