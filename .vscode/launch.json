{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome: attach to running dev server",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "webpack://resume-2026/./*": "${workspaceFolder}/src/*",
        "webpack://resume-2026/*": "*"
      }
    }
  ]
}
